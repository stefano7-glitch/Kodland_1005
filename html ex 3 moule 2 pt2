body {
    font-family: Arial,  sans-serif; /* La famiglia del font */
    font-size: 20px; /* La dimensione del font principale nei tag <p></p> */
    background-color: #020000; /* Il colore dello sfondo della pagina web */
    color: #fcfafa; /* Il colore del testo */ 
    text-decoration-color:#dd1515
}
h1 {
    color: #5988ff; /* Il colore dell'intestazione */
    font-size: 20px; /* La dimensione del font dell'intestazione */
    font-family: Georgia, serif; /* La famiglia del font usata nell'intestazione */
}

.ciao {
    color:#faf600;
    font-size: 40px;
}

#prova_id {
    color: #25fd09;
    font-size: 80px;
}

@keyframes color-change {
          0% {
            color: rgb(251, 255, 0);
          }

          50% {
            color: red;
          }

          100% {
            color: rgb(0, 255, 213);
          }
}

        h3 {
          animation: color-change 5s infinite;
        }
      
